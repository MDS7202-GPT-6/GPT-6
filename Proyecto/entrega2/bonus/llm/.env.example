# ====================================================
# 🔐 Variables de Entorno - Airflow + MLflow
# ====================================================

# Usuario y contraseña de Airflow Web UI
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# UID para permisos de archivos
AIRFLOW_UID=501

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000

# Groq API Configuration
# Obtén tu API key gratuita en: https://console.groq.com/keys
GROQ_API_KEY=key_aqui

# Modelo a utilizar (opciones: llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it)
GROQ_MODEL=llama-3.1-8b-instant

# Configuración del chatbot
MAX_TOKENS=1024
TEMPERATURE=0.7