# .gitignore for GPT-6 repository

# --------------------------
# Python
# --------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
.Python

# Virtual environments
venv/
env/
ENV/
.venv/
.pyenv/

# pip/misc
pip-wheel-metadata/
*.dist-info/

# --------------------------
# Editor / OS
# --------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# --------------------------
# Jupyter
# --------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# --------------------------
# Testing / tooling
# --------------------------
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --------------------------
# Logs and runtime files
# --------------------------
logs/
*.log
*.pid

# --------------------------
# Environment / Secrets
# --------------------------
.env
.env.*
secrets.env
credentials.json
*.pem
*.key



# --------------------------
# Docker / Compose
# --------------------------
.env.dev
.env.local

# --------------------------
# Build / Distribution
# --------------------------
build/
dist/
*.egg

# --------------------------
# Misc
# --------------------------
*.cache/
.cache/
coverage/

# Allow developer to track specific files by removing them from .gitignore as needed
# End of .gitignore
